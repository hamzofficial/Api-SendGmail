{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/verify-apikey.js"
    }
  ],
  "crons": [
    {
      "path": "/api/daily-report",
      "schedule": "5 17 * * *"
    },
    {
      "path": "/api/cleanup-expired-keys",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/reset-daily-usage",
      "schedule": "0 17 * * *"
    }
  ]
}
